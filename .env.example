# ── Choose your LLM provider ────────────────────────────────────────────────
# anthropic  → best quality; paid; does NOT train on your data
# gemini     → FREE tier available (AI Studio key). ⚠️ Google's free tier uses
#              prompts for training — okay for a pilot, enable billing or switch
#              provider before company-wide rollout with sensitive questions.
# groq       → free + private (no training), but only works with small prompts
#              (needs retrieval mode; not with the full knowledge base in context)
# openrouter → free models rotate; check openrouter.ai for current ones
# custom     → any OpenAI-compatible endpoint (set BOT_BASE_URL + BOT_API_KEY)
BOT_PROVIDER=gemini

# Key for the provider you chose (only the matching one is needed):
# ANTHROPIC_API_KEY=sk-ant-...          # https://platform.claude.com/
GEMINI_API_KEY=your-key-here            # free at https://aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...                  # https://console.groq.com/
# OPENROUTER_API_KEY=sk-or-...          # https://openrouter.ai/
# BOT_BASE_URL=                         # only for BOT_PROVIDER=custom
# BOT_API_KEY=                          # only for BOT_PROVIDER=custom

# Optional overrides
# BOT_MODEL=gemini-3-flash              # default: claude-opus-5 (anthropic) / gemini-3-flash (gemini)
# BOT_EFFORT=medium                     # anthropic only: low | medium | high
# BOT_MAX_TOKENS=2048

# Optional — email escalations to HR (otherwise only logged to data/escalations.jsonl)
# HR_EMAIL=hr@urbanroof.in
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bot@urbanroof.in
# SMTP_PASSWORD=app-password-here
# SMTP_FROM=hr-assistant@urbanroof.in
