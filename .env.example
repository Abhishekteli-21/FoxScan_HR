# Required — your Anthropic API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model & behavior tuning
# BOT_MODEL=claude-opus-5
# BOT_EFFORT=medium          # low | medium | high  (higher = smarter, slower)
# BOT_MAX_TOKENS=2048

# Optional — email escalations to HR (otherwise they are only logged to data/escalations.jsonl)
# HR_EMAIL=hr@urbanroof.in
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bot@urbanroof.in
# SMTP_PASSWORD=app-password-here
# SMTP_FROM=hr-assistant@urbanroof.in
